---
import type { ProfileProject } from "../lib/github-projects";

interface Props
{
  project: ProfileProject;
}

const { project } = Astro.props;
---

<div data-profile-project={project.id} data-profile-title={project.title}>
  {project.groups.map(({ title, rows }) => (
    <>
      {title && <h2>{title}</h2>}
      <ul>
        {rows.map(({ name, description, href, status, statusLink }) => (
          <li>
            <a href={href}>{name}</a>{` – ${description}`}
            {!title && <small class="project-row-status">{statusLink ? <a href={statusLink.href}>{statusLink.name}</a> : status}</small>}
          </li>
        ))}
      </ul>
    </>
  ))}
  {project.links.map(({ name, href }) => <p><a href={href}>{name}</a></p>)}
</div>

<script>
  import { loadProfileProjects } from "../lib/github-projects";

  function createLink(name: string, href: string)
  {
    const link = document.createElement("a");
    link.href = href;
    link.textContent = name;
    return link;
  }

  async function refreshProfileProject()
  {
    const list = document.querySelector<HTMLElement>("[data-profile-project]");
    if (!list) return;

    try {
      const projects = await loadProfileProjects();
      const project = projects.find(({ id, title }) =>
        id === list.dataset.profileProject && title === list.dataset.profileTitle);
      if (!project) return;

      const updated = document.createDocumentFragment();
      for (const { title, rows } of project.groups) {
        if (title) {
          const heading = document.createElement("h2");
          heading.textContent = title;
          updated.append(heading);
        }

        const entries = document.createElement("ul");
        for (const { name, description, href, status, statusLink } of rows) {
          const entry = document.createElement("li");
          entry.append(createLink(name, href), ` – ${description}`);
          if (!title) {
            const label = document.createElement("small");
            label.className = "project-row-status";
            label.append(statusLink ? createLink(statusLink.name, statusLink.href) : status);
            entry.append(label);
          }
          entries.append(entry);
        }
        updated.append(entries);
      }

      for (const { name, href } of project.links) {
        const paragraph = document.createElement("p");
        paragraph.append(createLink(name, href));
        updated.append(paragraph);
      }

      const unchanged = list.children.length === updated.children.length
        && Array.from(list.children).every((child, index) => child.isEqualNode(updated.children[index]));
      if (!unchanged) list.replaceChildren(updated);
    } catch {
      // Keep the static project list if GitHub is unavailable or the format changes.
    }
  }

  void refreshProfileProject();
</script>
