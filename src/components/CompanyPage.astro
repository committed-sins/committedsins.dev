---
import { getEntry, render } from "astro:content";
import PageBanner from "./PageBanner.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const company = await getEntry("company", "aureka");
const { Content } = await render(company);
const { title, description, website } = company.data;
const canonical = new URL("/company/", Astro.site).href;
---

<SiteLayout title={title} description={`${title} ${description}`} canonical={canonical}>
  <PageBanner title={title}>
    <a class="back-link" href="/#company">Business</a>
  </PageBanner>
  <div class="shell section">
    <div class="prose">
      <Content />
      <p><a href={website}>Visit {new URL(website).hostname}</a></p>
    </div>
    <slot />
  </div>
</SiteLayout>
