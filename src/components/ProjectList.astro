---
import type { getSiteProjects } from "../lib/site-projects";

interface Props
{
  projects: Awaited<ReturnType<typeof getSiteProjects>>;
}

const { projects } = Astro.props;
---

<ul class="entry-list">
  {projects.map(({ id, data }) => (
    <li>
      <a class="entry" href={`/projects/${id}/`}>
        <span class="entry-tag">{data.category}</span>
        <span class="entry-title">{data.title}</span>
        <span class="entry-summary">
          <span class="entry-description">{data.description}</span>
          {data.status && <span class="entry-status">{data.status}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>
