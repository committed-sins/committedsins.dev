---
import { getImage, Image } from "astro:assets";
import copperMonogram from "../assets/brand/committed-sins-copper.png";
import "../styles/site.css";

interface Props
{
  title: string;
  description: string;
  canonical?: string;
}

const { title, description } = Astro.props;
const siteName = "Committed Sins";
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const favicon = await getImage({ src: copperMonogram, width: 64, height: 64, format: "png" });
const canonical = Astro.props.canonical ?? (Astro.site && new URL(Astro.url.pathname, Astro.site));
const navigation = [
  { label: "Michael J. Stallinger", href: "/about/" },
  { label: "The changelogs", href: "/writing/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand-icon" href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>
          <span class="brand-icon-image">
            <Image src={copperMonogram} alt={siteName} width={88} format="webp" loading="eager" />
          </span>
        </a>
        <nav aria-label="Main">
          {navigation.map(({ label, href }) => (
            <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Force pushing with love · 2026<span hidden data-site-release><span aria-hidden="true"> · </span><a></a></span></p>
        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <a href="/imprint/" aria-current={Astro.url.pathname === "/imprint/" ? "page" : undefined}>Imprint</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import type { ProfileProject } from "../lib/github-projects";
  import { projectDirectories, websiteRepository } from "../lib/project-directories";

  async function showSiteRelease()
  {
    const container = document.querySelector<HTMLElement>("[data-site-release]");
    const link = container?.querySelector("a");
    if (!container || !link) return;

    try {
      const response = await fetch(`/data/${projectDirectories.personal.filename}`, { signal: AbortSignal.timeout(4_000) });
      if (!response.ok) return;

      const areas: ProfileProject[] = await response.json();
      const website = areas.flatMap(({ groups }) => groups.flatMap(({ rows }) => rows))
        .find(({ repository }) => repository === websiteRepository);
      const release = website?.release;
      if (!release?.name || !release.href.startsWith(`${websiteRepository}/releases/tag/`)) return;

      link.href = release.href;
      link.textContent = release.name;
      link.setAttribute("aria-label", `Website release ${release.name}`);
      container.hidden = false;
    } catch {
      // Keep the version hidden if the project snapshot is unavailable.
    }
  }

  void showSiteRelease();
</script>
