---
import { getImage, Image } from "astro:assets";
import copperMonogram from "../assets/brand/committed-sins-copper.png";
import "../styles/site.css";

interface Props
{
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = "Committed Sins";
const pageTitle = title === siteName ? "Committed Sins — changelogs nobody asked for" : `${title} · ${siteName}`;
const favicon = await getImage({ src: copperMonogram, width: 64, height: 64, format: "png" });
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
const navigation = [
  { label: "Projects", href: "/projects/" },
  { label: "Writing", href: "/writing/" },
  { label: "About", href: "/about/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand-icon" href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>
          <Image src={copperMonogram} alt={siteName} width={88} format="webp" loading="eager" />
        </a>
        <nav aria-label="Main">
          {navigation.map(({ label, href }) => (
            <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a href="/">Committed Sins</a>
        <div class="footer-links">
          <a href="/imprint/" aria-current={Astro.url.pathname === "/imprint/" ? "page" : undefined}>Imprint</a>
          <a href="https://github.com/committed-sins">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
