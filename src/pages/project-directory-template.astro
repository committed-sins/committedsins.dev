---
import { getCollection, render } from "astro:content";
import PageBanner from "../components/PageBanner.astro";
import ProjectOverviewSection from "../components/ProjectOverviewSection.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import githubIcon from "../assets/about/profiles/github.svg?raw";
import { projectDirectories } from "../lib/project-directories";
import projectRows from "../templates/project-rows.html?raw";

const entries = await getCollection("projects");
const introductions = await Promise.all(entries.map(async (entry) =>
{
  const { Content } = await render(entry);
  return { id: entry.id, Content };
}));

const directories = JSON.stringify(JSON.stringify(Object.values(projectDirectories)));
const projectLookup = `
{{- $path := .OriginalReq.URL.Path | trimSuffix "/" -}}
{{- $directory := dict -}}
{{- $isOverview := false -}}
{{- range (mustFromJson ${directories}) -}}
  {{- if and .home (eq $path (trimSuffix "/" .home)) -}}
    {{- $directory = . -}}
    {{- $isOverview = true -}}
  {{- else if hasPrefix .path $path -}}
    {{- $directory = . -}}
  {{- end -}}
{{- end -}}
{{- if not $directory -}}{{ httpError 404 }}{{- end -}}
{{- $owner := $directory.owner -}}
{{- $isPersonal := eq $owner "${projectDirectories.personal.owner}" -}}
{{- $snapshot := print "data/" $directory.filename -}}
{{- $areaPath := $directory.path -}}
{{- $slug := trimPrefix $areaPath $path -}}
{{- $backLink := ternary "/#other-projects" $directory.back $isOverview -}}
{{- $project := dict -}}
{{- if $isOverview -}}
  {{- $project = dict "title" $directory.title "description" "" -}}
{{- else -}}
  {{- if not (fileExists $snapshot) -}}{{ httpError 503 }}{{- end -}}
  {{- range (readFile $snapshot | mustFromJson) -}}
    {{- if eq .id $slug -}}{{- $project = . -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- if not $project -}}{{ httpError 404 }}{{- end -}}
`;
const title = "{{ $project.title | html }}";
const description = "{{ $project.description | html }}";
const canonical = `${new URL("/", Astro.site).origin}{{ $path | html }}/`;
---

<Fragment set:html={projectLookup} />
<SiteLayout title={title} description={description} canonical={canonical}>
  <article>
    <PageBanner title={title} description={description}>
      <a class="back-link" href="{{ $backLink }}" set:html={"{{ if $isOverview }}Others{{ else }}All projects{{ end }}"} />
      <Fragment set:html={`
        {{ with $project.topic }}
          <p class="entry-tag">
            <a href="https://github.com/orgs/{{ $owner }}/repositories?q={{ print "topic:" . | urlquery }}" aria-label="GitHub topic: {{ . | html }}">
              <span aria-hidden="true">#</span><code>{{ . | html }}</code>
            </a>
          </p>
        {{ end }}
      `} />
      <Fragment slot="after" set:html={`
        {{ if and $isPersonal (eq $project.topic "obsidian-plugin") }}
          <ul class="project-source-links" role="list">
            <li><a href="https://community.obsidian.md/users/committed-sins">Obsidian Community</a></li>
          </ul>
        {{ end }}
        {{ with $project.publication }}
          <p class="project-publication"><span class="entry-status">
            {{ if .href }}<a href="{{ .href | html }}">{{ .name | html }}</a>{{ else }}{{ .name | html }}{{ end }}
          </span></p>
        {{ end }}
      `} />
    </PageBanner>
    <div class="shell section">
      <Fragment set:html={"{{ if $isOverview }}"} />
      <ProjectOverviewSection />
      <Fragment set:html={"{{ else }}"} />
      {introductions.map(({ id, Content }) => (
        <>
          <Fragment set:html={`{{ if and $isPersonal (eq $slug ${JSON.stringify(id)}) }}`} />
          <div class="prose"><Content /></div>
          <Fragment set:html={'{{ end }}'} />
        </>
      ))}
      <Fragment set:html={projectRows.replaceAll("<!-- github-icon -->", githubIcon)} />
      <Fragment set:html={"{{ end }}"} />
    </div>
  </article>
</SiteLayout>
