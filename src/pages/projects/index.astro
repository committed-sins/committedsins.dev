---
import PageBanner from "../../components/PageBanner.astro";
import ProjectList from "../../components/ProjectList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getSiteProjects } from "../../lib/site-projects";

const projects = await getSiteProjects();
---

<SiteLayout title="Projects" description="The software, sites, and tools I build under Committed Sins.">
  <PageBanner title="Projects" description="Most of these started with something I wanted to use myself." />
  <div class="shell section">
    <ProjectList projects={projects} />
  </div>
</SiteLayout>
