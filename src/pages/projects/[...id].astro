---
import { render } from "astro:content";
import PageBanner from "../../components/PageBanner.astro";
import ProfileProjectList from "../../components/ProfileProjectList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getSiteProjects } from "../../lib/site-projects";

export async function getStaticPaths()
{
  const projects = await getSiteProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, category, status } = project.data;
const Content = project.local && (await render(project.local)).Content;
---

<SiteLayout title={title} description={description}>
  <article>
    <PageBanner title={title} description={description}>
      <a class="back-link" href="/#projects">All projects</a>
      <p class="entry-tag">{category}</p>
    </PageBanner>
    <div class="shell section">
      <div class="prose">
        {Content && <Content />}
        {project.profile && <ProfileProjectList project={project.profile} />}
      </div>
      {status && !project.profile && <footer class="project-status"><strong>Status</strong> · {status}</footer>}
    </div>
  </article>
</SiteLayout>
