---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths()
{
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, category } = project.data;
const { Content } = await render(project);
---

<SiteLayout title={title} description={description}>
  <article class="shell page">
    <header class="page-heading">
      <a class="back-link" href="/projects/">All projects</a>
      <p class="entry-tag">{category}</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>
