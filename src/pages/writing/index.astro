---
import { getCollection } from "astro:content";
import ArticleList from "../../components/ArticleList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const articles = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((first, second) => second.data.published.getTime() - first.data.published.getTime());
---

<SiteLayout title="A place for the changelogs" description="Occasional articles by Michael J. Stallinger.">
  <div class="shell page">
    <header class="page-heading"><h1>A place for the changelogs</h1></header>
    {articles.length > 0 ? <ArticleList articles={articles} /> : <p class="empty-state">No articles yet.</p>}
  </div>
</SiteLayout>
