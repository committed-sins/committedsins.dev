---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import copperMonogram from "../assets/brand/committed-sins-copper.png";
import ArticleList from "../components/ArticleList.astro";
import DirectoryLinks from "../components/DirectoryLinks.astro";
import ProjectOverview from "../components/ProjectOverview.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { otherProjectDirectories } from "../lib/project-directories";

const { data: company } = await getEntry("company", "aureka");
const articles = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((first, second) => second.data.published.getTime() - first.data.published.getTime());
---

<SiteLayout title="Committed Sins" description="Servers, websites, and other inconveniences. Projects and occasional writing.">
  <header class="hero-wrap">
    <div class="shell hero home-hero">
      <div class="hero-copy">
        <h1>Committed<br /> Sins</h1>
        <p class="subtitle">Servers, websites, and other inconveniences.</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <Image
          src={copperMonogram}
          alt=""
          widths={[320, 480, 720]}
          sizes="min(35vw, 20rem)"
          format="webp"
        />
      </div>
    </div>
  </header>
  <div class="shell home-intro">
    <p class="prose">I started Committed Sins to give my (side) projects a home.</p>
  </div>
  <section class="shell section section-followup" aria-labelledby="projects">
    <div class="section-heading">
      <div>
        <h2 id="projects">Projects</h2>
        <p class="subtitle section-intro">Most of these started with something I wanted to use myself.</p>
      </div>
    </div>
    <ProjectOverview directory="personal" />
  </section>
  <section class="shell section section-followup" aria-labelledby="company">
    <div class="section-heading">
      <div>
        <h2 id="company">Company</h2>
        <p class="subtitle section-intro">{company.description}</p>
      </div>
    </div>
    <DirectoryLinks entries={[{ name: company.title, href: "/company/", label: new URL(company.website).hostname }]} />
  </section>
  <section class="shell section section-followup" aria-labelledby="other-projects">
    <div class="section-heading">
      <h2 id="other-projects">Other projects</h2>
    </div>
    <DirectoryLinks entries={otherProjectDirectories.map(({ title, path, owner }) => ({ name: title, href: path, label: owner }))} />
  </section>
  {articles.length > 0 && (
    <section class="shell section section-followup" aria-labelledby="writing">
      <div class="section-heading">
        <div>
          <h2 id="writing">The changelogs</h2>
          <p class="subtitle section-intro">Occasional writing</p>
        </div>
        <a href="/writing/">All posts</a>
      </div>
      <ArticleList articles={articles.slice(0, 2)} />
    </section>
  )}
</SiteLayout>
