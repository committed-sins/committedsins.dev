---
import { Image } from "astro:assets";
import aurekaIcon from "../assets/about/aureka-icon.png";
import bmdIcon from "../assets/about/bmd-icon.png";
import portrait from "../assets/about/michael-portrait.jpg";
import glassImage from "../assets/about/mjs-glass.png";
import GitHubIcon from "../assets/about/profiles/github.svg";
import LinkedInIcon from "../assets/about/profiles/linkedin.svg";
import StackOverflowIcon from "../assets/about/profiles/stack-overflow.svg";
import SiteLayout from "../layouts/SiteLayout.astro";

const work = [
  { name: "Aureka Systems e.U.", href: "https://aureka.at/", role: "Founder", icon: aurekaIcon },
  { name: "BMD Systemhaus GmbH", href: "https://bmd.at/", role: "Team leader, development consultant", icon: bmdIcon },
];

const profiles = [
  { name: "LinkedIn", href: "https://www.linkedin.com/in/mjstallinger/", Icon: LinkedInIcon },
  { name: "GitHub", href: "https://github.com/mjStallinger", Icon: GitHubIcon },
  { name: "Stack Overflow", href: "https://stackoverflow.com/users/mjstallinger", Icon: StackOverflowIcon },
];
---

<SiteLayout title="Michael J. Stallinger" description="About Michael J. Stallinger and Committed Sins.">
  <article>
    <header class="hero-wrap">
      <div class="shell page-banner about-banner">
        <h1>Michael J. Stallinger</h1>
        <p class="subtitle">Senior software developer.<br />Turns small inconveniences into projects, occasionally companies.</p>
      </div>
    </header>
    <div class="shell section about-layout">
      <div class="prose about-intro">
        <p>Committed Sins is my personal site.</p>
        <p>It’s where I keep the changelogs for things that were supposed to take five minutes.</p>
      </div>
      <figure class="about-portrait">
        <div class="about-frame">
          <Image
            src={portrait}
            alt="Black-and-white portrait of Michael J. Stallinger"
            width={544}
            widths={[192, 272, 384, 544]}
            sizes="(max-width: 44rem) 12rem, 17rem"
            format="webp"
          />
        </div>
      </figure>
      <div class="prose about-details">
        <section aria-labelledby="work">
          <h2 id="work">Work</h2>
          <p class="subtitle section-intro">Where the bills get paid.</p>
          <ul class="about-links" role="list">
            {work.map(({ name, href, role, icon }) => (
              <li>
                <a href={href}><img src={icon.src} alt="" width="16" height="16" />{name}</a>
                <p class="about-role">{role}</p>
              </li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="profiles">
          <h2 id="profiles">Profiles</h2>
          <p class="subtitle section-intro">Elsewhere, same person.</p>
          <ul class="about-links" role="list">
            {profiles.map(({ name, href, Icon }) => (
              <li><a href={href}><Icon aria-hidden="true" focusable="false" />{name}</a></li>
            ))}
          </ul>
        </section>
        <Image class="about-signature" src={glassImage} alt="MJS monogram" width={192} widths={[96, 192]} sizes="6rem" format="webp" />
      </div>
    </div>
  </article>
</SiteLayout>
