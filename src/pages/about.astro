---
import { Image } from "astro:assets";
import glassImage from "../assets/about/mjs-glass.png";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Michael J. Stallinger" description="About Michael J. Stallinger and Committed Sins.">
  <article>
    <header class="hero-wrap">
      <div class="shell hero about-hero">
        <div>
          <h1>Michael J.<br /> Stallinger</h1>
          <p class="subtitle">Senior software developer.<br />Turns small inconveniences into projects, occasionally companies.</p>
        </div>
        <div class="about-frame">
          <Image
            src={glassImage}
            alt=""
            width={960}
            widths={[400, 640, 960]}
            sizes="(max-width: 44rem) min(calc(100vw - 3rem), 22rem), min(36vw, 22rem)"
            format="webp"
            priority
          />
        </div>
      </div>
    </header>
    <section class="shell section" aria-labelledby="about">
      <div class="section-heading">
        <h2 id="about">About</h2>
      </div>
      <div class="prose">
        <p>Committed Sins is my personal site.<br />It’s where I keep the changelogs for things that were supposed to take five minutes.</p>
        <p>One project especially close to my heart is <a href="/projects/realmglass/">Realmglass</a>, a Minecraft dashboard I’m building with and for my son.</p>
        <section class="about-work" aria-labelledby="work">
          <h3 id="work">Work</h3>
          <ul>
            <li>Founder of <a href="https://aureka.at/">Aureka Systems e.U.</a></li>
            <li>Team leader, development consultant at <a href="https://bmd.at/">BMD Systemhaus GmbH</a></li>
          </ul>
        </section>
        <div class="about-links">
          <a href="/projects/">Explore my projects</a>
          <a href="https://www.linkedin.com/in/mjstallinger/">LinkedIn</a>
        </div>
      </div>
    </section>
  </article>
</SiteLayout>
