{
	admin off
	persist_config off
}

:80 {
	root * /srv/site
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://raw.githubusercontent.com/committed-sins/.github/main/profile/README.md; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	file_server
}
